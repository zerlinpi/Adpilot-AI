# AdPilot AI — Frontend production environment (read by `vite build`)
# ============================================================
# Backend API origin. The frontend issues all calls against relative
# `/api/...` paths; this value is prefixed at build time so the deployed
# frontend can reach the backend.
#
# RECOMMENDED: leave this BLANK and reverse-proxy `/api` from the frontend host
# to the backend (same-origin, no CORS). See deploy/nginx.conf for an example.
#
# Alternatively set it to your backend origin, e.g.
#   VITE_API_BASE_URL=https://api.your-domain.example
# If you cross-origin call the backend, its CORS allowed-origins (CORS_ORIGINS
# in application-prod.yml) must include the frontend origin.
VITE_API_BASE_URL=
